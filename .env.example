# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing internal authentication JWTs
JWT_SECRET="recruitment-ai-jwt-secret-key-production-ready"

# AUTH_PROVIDER: Switchable provider ("internal", "firebase", "supabase")
AUTH_PROVIDER="internal"

# DATABASE_URL: Optional external relational database connection string
DATABASE_URL="mysql://root:password@localhost:3306/recruitment_ai_db"

